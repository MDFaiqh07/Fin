{
  "name": "fintrack",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "admin:seed": "npm run seed:admin --workspace server",
    "demo:seed": "npm run seed:demo --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
